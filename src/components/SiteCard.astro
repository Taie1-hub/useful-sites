---
export interface Props {
  title: string;
  url: string;
  description: string;
  tags: string[];
  category: string;
  freeTier: string;
  language: string;
  featured?: boolean;
}

const { title, url, description, tags, category, freeTier, language, featured } = Astro.props;

const categoryLabels: Record<string, string> = {
  ai: '🤖 AI工具',
  design: '🎨 设计素材',
  productivity: '📋 效率办公',
  video: '🎬 视频剪辑',
  dev: '🛠 开发者工具',
  other: '📦 其他',
};

const freeTierBadge = freeTier === 'free'
  ? 'bg-green-100 text-green-700'
  : freeTier === 'freemium'
    ? 'bg-yellow-100 text-yellow-700'
    : 'bg-gray-100 text-gray-600';

const freeTierLabel = freeTier === 'free' ? '完全免费' : freeTier === 'freemium' ? '有免费额度' : '付费';
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="block bg-white rounded-xl border border-gray-100 p-5 hover:shadow-lg hover:border-brand-200 hover:-translate-y-0.5 transition-all duration-200 group"
>
  <div class="flex items-start justify-between gap-2 mb-2">
    <h3 class="font-semibold text-base text-gray-900 group-hover:text-brand-600 transition-colors truncate">
      {title}
    </h3>
    {featured && <span class="shrink-0 text-xs bg-brand-100 text-brand-700 px-1.5 py-0.5 rounded">精选</span>}
  </div>

  <p class="text-sm text-gray-500 leading-relaxed mb-3 line-clamp-2">{description}</p>

  <div class="flex items-center gap-2 mb-3 flex-wrap">
    <span class={`text-xs px-2 py-0.5 rounded-full ${freeTierBadge}`}>{freeTierLabel}</span>
    <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">{language}</span>
  </div>

  <div class="flex items-center gap-1.5 flex-wrap">
    <span class="text-xs text-gray-400 bg-gray-50 px-1.5 py-0.5 rounded">{categoryLabels[category] || category}</span>
    {tags.slice(0, 3).map(tag => (
      <span class="text-xs text-gray-400">#{tag}</span>
    ))}
  </div>
</a>
