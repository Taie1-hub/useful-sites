---
import Layout from '../layouts/Layout.astro';
import SiteCard from '../components/SiteCard.astro';
import { getCollection } from 'astro:content';

const sites = await getCollection('sites');

const sortedSites = sites
  .map(site => ({ ...site.data, id: site.id }))
  .sort((a, b) => {
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return a.sortOrder - b.sortOrder;
  });

const categories = [
  { key: 'all', label: '全部', emoji: '🌟' },
  { key: 'ai', label: 'AI工具', emoji: '🤖' },
  { key: 'design', label: '设计素材', emoji: '🎨' },
  { key: 'productivity', label: '效率办公', emoji: '📋' },
  { key: 'video', label: '视频剪辑', emoji: '🎬' },
  { key: 'dev', label: '开发工具', emoji: '🛠' },
  { key: 'other', label: '其他', emoji: '📦' },
];

const featuredSites = sortedSites.filter(s => s.featured);
const normalSites = sortedSites.filter(s => !s.featured);
---

<Layout title="首页" description="收录优质实用在线工具和网站资源">
  <!-- Hero -->
  <section class="text-center mb-10 pt-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass text-sm text-[var(--color-text-secondary)] mb-5">
      <span class="gradient-dot gradient-dot-pink"></span>
      精心筛选 · 实测好用
      <span class="gradient-dot gradient-dot-purple"></span>
    </div>
    <h1 class="text-4xl font-extrabold mb-4 leading-tight">
      <span class="bg-gradient-to-r from-[var(--color-candy-pink)] via-[var(--color-candy-purple)] to-[var(--color-candy-blue)] bg-clip-text text-transparent">
        发现好用网站
      </span>
    </h1>
    <p class="text-[var(--color-text-secondary)] text-base max-w-lg mx-auto leading-relaxed">
      AI工具、设计素材、效率神器……每个网站都亲自体验过，<br/>帮你省去筛选的时间。
    </p>
  </section>

  <!-- 搜索 & 筛选 -->
  <section class="mb-10" id="filter-section">
    <!-- 搜索栏 -->
    <div class="max-w-lg mx-auto mb-6">
      <div class="glass rounded-2xl flex items-center px-4 py-3.5 gap-3 ring-1 ring-white/60 focus-within:ring-[var(--color-candy-purple)] focus-within:ring-2 transition-all">
        <span class="text-lg">🔍</span>
        <input
          type="text"
          id="search-input"
          placeholder="搜索网站名称、标签、描述……"
          class="flex-1 bg-transparent text-sm text-[var(--color-text-primary)] placeholder:text-[var(--color-text-muted)] outline-none border-none"
        />
      </div>
    </div>

    <!-- 分类按钮 -->
    <div class="flex justify-center flex-wrap gap-2">
      {categories.map(cat => (
        <button
          class="category-btn glass px-4 py-2 text-sm rounded-xl text-[var(--color-text-secondary)] transition-all duration-200 hover:glass-strong"
          data-category={cat.key}
        >
          {cat.emoji} {cat.label}
        </button>
      ))}
    </div>
  </section>

  <!-- 精选推荐 -->
  {featuredSites.length > 0 && (
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <div class="flex items-center gap-2 px-3 py-1.5 glass rounded-xl text-sm font-medium text-[var(--color-text-secondary)]">
          <span class="gradient-dot gradient-dot-pink"></span>
          精选推荐
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredSites.map(site => (
          <SiteCard {...site} />
        ))}
      </div>
    </section>
  )}

  <!-- 全部网站 -->
  <section>
    <div class="flex items-center gap-3 mb-5">
      <div class="flex items-center gap-2 px-3 py-1.5 glass rounded-xl text-sm font-medium text-[var(--color-text-secondary)]">
        <span class="gradient-dot gradient-dot-purple"></span>
        全部网站
        <span class="text-[var(--color-text-muted)] font-normal" id="site-count">({sortedSites.length})</span>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="site-grid">
      {normalSites.map(site => (
        <div class="site-card-wrapper" data-category={site.category}>
          <SiteCard {...site} />
        </div>
      ))}
    </div>
    <div id="no-results" class="hidden text-center py-16 text-[var(--color-text-muted)]">
      <p class="text-5xl mb-4">🔮</p>
      <p class="text-lg">没有匹配的网站，试试换个关键词</p>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const categoryBtns = document.querySelectorAll('.category-btn');
  const allCards = document.querySelectorAll('.site-card-wrapper');
  const noResults = document.getElementById('no-results')!;
  const siteCount = document.getElementById('site-count')!;

  let activeCategory = 'all';

  function filterCards() {
    const query = searchInput?.value.toLowerCase() || '';
    let visibleCount = 0;

    allCards.forEach((card) => {
      const el = card as HTMLElement;
      const category = el.dataset.category || '';
      const text = el.textContent?.toLowerCase() || '';

      const matchCategory = activeCategory === 'all' || category === activeCategory;
      const matchSearch = query === '' || text.includes(query);
      const match = matchCategory && matchSearch;

      el.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    siteCount.textContent = `(${visibleCount})`;

    noResults.classList.toggle('hidden', visibleCount > 0);
  }

  searchInput?.addEventListener('input', filterCards);

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = (btn as HTMLElement).dataset.category || 'all';

      categoryBtns.forEach((b) => {
        b.classList.remove('glass-strong');
        b.classList.add('glass');
      });
      btn.classList.add('glass-strong');
      btn.classList.remove('glass');

      filterCards();
    });
  });

  (categoryBtns[0] as HTMLElement)?.click();
</script>
