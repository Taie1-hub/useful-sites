---
import Layout from '../../layouts/Layout.astro';
import SiteCard from '../../components/SiteCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sites = await getCollection('sites');
  const categories = [...new Set(sites.map(s => s.data.category))];
  return categories.map(cat => ({ params: { slug: cat } }));
}

const { slug } = Astro.params;
const sites = await getCollection('sites');
const categorySites = sites
  .filter(s => s.data.category === slug)
  .map(site => ({ ...site.data, id: site.id }))
  .sort((a, b) => a.sortOrder - b.sortOrder);

const categoryMeta: Record<string, { emoji: string; name: string; gradient: string }> = {
  ai: { emoji: '🤖', name: 'AI工具', gradient: 'from-[#c44dff] to-[#ff6b9d]' },
  design: { emoji: '🎨', name: '设计素材', gradient: 'from-[#ff6b9d] to-[#ff7b5c]' },
  productivity: { emoji: '📋', name: '效率办公', gradient: 'from-[#4da6ff] to-[#4de8b2]' },
  video: { emoji: '🎬', name: '视频剪辑', gradient: 'from-[#ff7b5c] to-[#ff6b9d]' },
  dev: { emoji: '🛠', name: '开发者工具', gradient: 'from-[#6366f1] to-[#818cf8]' },
  other: { emoji: '📦', name: '其他工具', gradient: 'from-[#a094b0] to-[#c4b5fd]' },
};

const meta = categoryMeta[slug] || { emoji: '📦', name: slug, gradient: 'from-[#a094b0] to-[#c4b5fd]' };
---

<Layout title={`${meta.emoji} ${meta.name}`}>
  <div class="mb-6">
    <a href="/" class="inline-flex items-center gap-1 text-sm glass px-3 py-1.5 rounded-xl text-[var(--color-text-secondary)] hover:glass-strong transition-all">
      &larr; 返回首页
    </a>
  </div>

  <div class="flex items-center gap-4 mb-3">
    <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-sm"
      style="background: linear-gradient(135deg, var(--color-candy-pink), var(--color-candy-purple));">
      {meta.emoji}
    </div>
    <div>
      <h1 class={`text-2xl font-bold bg-gradient-to-r ${meta.gradient} bg-clip-text text-transparent`}>
        {meta.name}
      </h1>
      <p class="text-sm text-[var(--color-text-muted)]">共收录 {categorySites.length} 个网站</p>
    </div>
  </div>

  {categorySites.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
      {categorySites.map(site => <SiteCard {...site} />)}
    </div>
  ) : (
    <div class="text-center py-16 text-[var(--color-text-muted)]">
      <p class="text-5xl mb-4">📭</p>
      <p class="text-lg">该分类下暂无网站</p>
    </div>
  )}
</Layout>
